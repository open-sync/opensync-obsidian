{
  "name": "opensync-obsidian",
  "version": "0.1.0",
  "description": "Free, end-to-end encrypted sync for Obsidian vaults.",
  "main": "main.js",
  "scripts": {
    "wasm": "npm --prefix ../opensync/packages/client run wasm",
    "build": "npm run wasm && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:obsidian": "node scripts/build.mjs && node checks/obsidiancheck.mjs",
    "shots": "node checks/capture.mjs docs/screenshots",
    "check:tiers": "node scripts/build.mjs && node checks/tierscheck.mjs",
    "check:hosted": "OPENSYNC_HOSTED_RELAY=wss://relay01.opensync.network/ node scripts/build.mjs && node checks/hostedcheck.mjs",
    "check:all": "npm run check:obsidian && npm run check:tiers && npm run check:hosted"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  },
  "//": "The client library is imported by relative path and bundled by esbuild; it is not published."
}
